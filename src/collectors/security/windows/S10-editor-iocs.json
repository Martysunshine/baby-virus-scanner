{
  "schema": "bvs.iocs/1",
  "module": "S10",
  "updated": "2026-10-20",
  "description": "Detection data for S10-editors-git.ps1 (editor extensions, editor settings, repo auto-run vectors, git). Regexes are .NET syntax, compiled IgnoreCase|CultureInvariant with a 2 s timeout. Edit here, not in the collector. Nothing in this file is machine-specific.",

  "intel": {
    "vscodeControlUrlFallback": "https://main.vscode-cdn.net/extensions/marketplace.json",
    "vscodeMarketplaceQuery": "https://marketplace.visualstudio.com/_apis/public/gallery/extensionquery",
    "vscodeMarketplaceFlags": 789,
    "vscodeMarketplaceBatch": 40,
    "removedPackagesUrl": "https://raw.githubusercontent.com/microsoft/vsmarketplace/main/RemovedPackages.md",
    "openVsxApi": "https://open-vsx.org/api",
    "cursorControlUrlFallback": "https://api2.cursor.sh/extensions-control",
    "removedPackageTypeSeverity": {
      "malware": "critical",
      "spam / malware": "critical",
      "impersonation, malware": "critical",
      "impersonation": "high",
      "typo-squatting": "high",
      "typosquatting": "high",
      "potentially malicious": "high",
      "untrustworthy": "high",
      "spam": "low",
      "copyright violation": "low",
      "expired domain": "low"
    }
  },

  "editors": [
    { "key": "vscode",          "name": "VS Code",          "extDir": "%USERPROFILE%\\.vscode\\extensions",          "userDir": "%APPDATA%\\Code\\User",          "uninstallName": "^Microsoft Visual Studio Code(?! Insiders)", "gallery": "vsmarketplace", "envExtDir": "VSCODE_EXTENSIONS", "defaults": { "trustEnabled": true,  "allowAutomaticTasks": "off" } },
    { "key": "vscode-insiders", "name": "VS Code Insiders", "extDir": "%USERPROFILE%\\.vscode-insiders\\extensions", "userDir": "%APPDATA%\\Code - Insiders\\User", "uninstallName": "^Microsoft Visual Studio Code Insiders",    "gallery": "vsmarketplace", "defaults": { "trustEnabled": true,  "allowAutomaticTasks": "off" } },
    { "key": "cursor",          "name": "Cursor",           "extDir": "%USERPROFILE%\\.cursor\\extensions",          "userDir": "%APPDATA%\\Cursor\\User",        "uninstallName": "^Cursor\\b",                                 "gallery": "openvsx",       "defaults": { "trustEnabled": false, "allowAutomaticTasks": "on" } },
    { "key": "vscodium",        "name": "VSCodium",         "extDir": "%USERPROFILE%\\.vscode-oss\\extensions",      "userDir": "%APPDATA%\\VSCodium\\User",      "uninstallName": "^VSCodium",                                  "gallery": "openvsx",       "defaults": { "trustEnabled": true,  "allowAutomaticTasks": "off" } },
    { "key": "windsurf",        "name": "Windsurf",         "extDir": "%USERPROFILE%\\.windsurf\\extensions",        "userDir": "%APPDATA%\\Windsurf\\User",      "uninstallName": "^Windsurf",                                  "gallery": "openvsx",       "defaults": { "trustEnabled": null,  "allowAutomaticTasks": null } },
    { "key": "kiro",            "name": "Kiro",             "extDir": "%USERPROFILE%\\.kiro\\extensions",            "userDir": "%APPDATA%\\Kiro\\User",          "uninstallName": "^Kiro",                                      "gallery": "openvsx",       "defaults": { "trustEnabled": null,  "allowAutomaticTasks": null } },
    { "key": "trae",            "name": "Trae",             "extDir": "%USERPROFILE%\\.trae\\extensions",            "userDir": "%APPDATA%\\Trae\\User",          "uninstallName": "^Trae",                                      "gallery": "openvsx",       "defaults": { "trustEnabled": null,  "allowAutomaticTasks": null } },
    { "key": "antigravity",     "name": "Antigravity",      "extDir": "%USERPROFILE%\\.antigravity\\extensions",     "userDir": "%APPDATA%\\Antigravity\\User",   "uninstallName": "^Antigravity",                               "gallery": "openvsx",       "defaults": { "trustEnabled": null,  "allowAutomaticTasks": null } },
    { "key": "positron",        "name": "Positron",         "extDir": "%USERPROFILE%\\.positron\\extensions",        "userDir": "%APPDATA%\\Positron\\User",      "uninstallName": "^Positron",                                  "gallery": "openvsx",       "defaults": { "trustEnabled": true,  "allowAutomaticTasks": "off" } }
  ],

  "unicode": {
    "runRegex": "(?:[\\uFE00-\\uFE0F\\u200B-\\u200F\\u202A-\\u202E\\u2066-\\u2069]|\\uDB40[\\uDC00-\\uDC7F\\uDD00-\\uDDEF])",
    "minRun": 10,
    "note": "U+FE00-FE0F and U+E0100-E01EF variation selectors (GlassWorm payload encoding), U+E0000-E007F tags (ASCII smuggling), U+200B-200F zero-width/LRM/RLM, U+202A-202E and U+2066-2069 bidi controls (Trojan Source)."
  },

  "glassworm": {
    "solanaRpcHosts": [
      "api.mainnet-beta.solana.com", "api.devnet.solana.com", "api.testnet.solana.com",
      "solana-mainnet.g.alchemy.com", "mainnet.helius-rpc.com", "rpc.helius.xyz",
      "rpc.ankr.com/solana", "solana-api.projectserum.com", "solana.public-rpc.com",
      "solana-rpc.publicnode.com", "solana-mainnet.rpc.extrnode.com", "ssc-dao.genesysgo.net",
      "rpc.shyft.to", "solana-mainnet.core.chainstack.com"
    ],
    "solanaMarkers": ["getSignaturesForAddress"],
    "genericSolanaUrl": "https?://[^\\s'\"/]*solana[^\\s'\"/]*",
    "solanaLibraryPathHint": "\\\\node_modules\\\\@solana\\\\",
    "deadDrops": [
      { "name": "google-calendar-short-link", "regex": "calendar\\.app\\.google/[A-Za-z0-9_-]{6,}", "severity": "high" },
      { "name": "google-calendar-event-link", "regex": "calendar\\.google\\.com/calendar/(?:u/\\d+/)?(?:r/)?event\\?[^\\s'\"]*eid=", "severity": "medium" }
    ]
  },

  "codeCapabilities": {
    "eval": "\\beval\\s*\\(|\\bnew\\s+Function\\s*\\(",
    "child_process": "child_process|\\bexecSync\\b|\\bspawnSync\\b|\\bexecFile(?:Sync)?\\s*\\(|process\\.binding\\(\\s*[\"']spawn_sync",
    "network": "require\\(\\s*[\"'](?:node:)?(?:https?|net|tls|dgram|dns)[\"']\\s*\\)|from\\s+[\"'](?:node:)?(?:https?|net|tls|dgram|dns)[\"']|\\bfetch\\s*\\(|XMLHttpRequest|new\\s+WebSocket\\s*\\(|\\baxios\\b|\\bhttps?\\.(?:request|get)\\s*\\("
  },

  "themeContributes": ["themes", "iconThemes", "productIconThemes"],

  "commandPatterns": {
    "download": "\\b(?:curl|wget|iwr|irm|Invoke-WebRequest|Invoke-RestMethod|Start-BitsTransfer|bitsadmin|DownloadString|DownloadFile|DownloadData|Net\\.WebClient)\\b|\\bcertutil(?:\\.exe)?\\s+[^\\r\\n]*-urlcache",
    "pipe_shell": "\\b(?:curl|wget|iwr|irm|Invoke-WebRequest|Invoke-RestMethod)\\b[^\\r\\n|]*\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh|dash|iex|Invoke-Expression|python[0-9.]*|node|pwsh|powershell)\\b",
    "encoded": "\\s-(?:e|ec|en|enc|enco|encod|encode|encoded|encodedc|encodedco|encodedcom|encodedcomm|encodedcomma|encodedcomman|encodedcommand)\\s+[A-Za-z0-9+/=]{20,}|FromBase64String|\\bbase64\\s+(?:-d|--decode|-D)\\b|\\batob\\s*\\(|Buffer\\.from\\([^)]{0,200}base64",
    "base64_word": "\\bbase64\\b",
    "inline_exec": "\\bnode(?:\\.exe)?\\s+(?:-e|--eval|-p|--print)\\b|\\bpython[0-9.]*(?:\\.exe)?\\s+-c\\b|\\bperl\\s+-e\\b|\\bruby\\s+-e\\b|\\bphp\\s+-r\\b|\\b(?:powershell|pwsh)(?:\\.exe)?\\b[^\\r\\n]*\\s-c(?:ommand)?\\b|\\bmshta\\b|\\brundll32\\b|\\bregsvr32\\b|\\bwscript\\b|\\bcscript\\b",
    "eval": "\\beval\\s*\\(|\\bnew\\s+Function\\s*\\(|\\bInvoke-Expression\\b|\\biex\\b",
    "reverse_shell": "/dev/tcp/|\\bnc(?:at)?(?:\\.exe)?\\s+[^\\r\\n]*\\s-[a-z]*e\\s|\\bbash\\s+-i\\s*>&|\\bsocat\\b[^\\r\\n]*exec:",
    "evasion": "-w(?:indowstyle)?\\s+hidden|\\s-nop\\b|\\s-noni\\b|-ExecutionPolicy\\s+Bypass|\\s-ep\\s+bypass|Set-MpPreference|Add-MpPreference|\\battrib\\s+\\+h",
    "disguised_script": "\\b(?:node|python[0-9.]*|bash|sh|pwsh|powershell)(?:\\.exe)?\\s+[\"']?[^\\s\"']+\\.(?:woff2?|ttf|otf|eot|png|jpe?g|gif|svg|ico|bmp|webp|mp3|mp4|wav|txt|log|dat|bin|csv)\\b",
    "paas_host": "\\b[a-z0-9-]+\\.(?:vercel\\.app|netlify\\.app|ngrok(?:-free)?\\.(?:io|app|dev)|trycloudflare\\.com|workers\\.dev|glitch\\.me|onrender\\.com|herokuapp\\.com|replit\\.(?:dev|app)|pages\\.dev|deno\\.dev|fly\\.dev|pythonanywhere\\.com)\\b|\\b(?:pastebin\\.com|paste\\.ee|hastebin\\.com|transfer\\.sh|file\\.io|0x0\\.st|bashupload\\.com|temp\\.sh)\\b",
    "ip_url": "\\bhttps?://\\d{1,3}(?:\\.\\d{1,3}){3}(?::\\d+)?(?:/|\\b)",
    "remote_url": "\\bhttps?://(?!(?:localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::1\\])(?:[:/]|$))[^\\s'\"<>]+",
    "package_install": "\\b(?:npm|pnpm|yarn|bun)\\s+(?:i|install|ci|add)\\b|\\bpip[0-9.]*(?:\\.exe)?\\s+install\\b|\\buv\\s+(?:pip\\s+install|sync)\\b|\\bpoetry\\s+install\\b"
  },

  "terminalEnvRisk": [
    { "name": "NODE_OPTIONS", "severity": "medium", "highIf": "--require|(?:^|\\s)-r\\s|--import|--loader|--experimental-loader|--inspect" },
    { "name": "ELECTRON_RUN_AS_NODE", "severity": "medium" },
    { "name": "NODE_TLS_REJECT_UNAUTHORIZED", "severity": "medium", "onlyIf": "^\\s*0\\s*$" },
    { "name": "LD_PRELOAD", "severity": "high" },
    { "name": "DYLD_INSERT_LIBRARIES", "severity": "high" },
    { "name": "COMSPEC", "severity": "high" },
    { "name": "PATHEXT", "severity": "high" },
    { "name": "BASH_ENV", "severity": "medium" },
    { "name": "ENV", "severity": "medium" },
    { "name": "PROMPT_COMMAND", "severity": "medium" },
    { "name": "PERL5OPT", "severity": "medium" },
    { "name": "RUBYOPT", "severity": "medium" },
    { "name": "PYTHONSTARTUP", "severity": "medium" },
    { "name": "PYTHONPATH", "severity": "medium" },
    { "name": "PSModulePath", "severity": "medium" },
    { "name": "GIT_SSH_COMMAND", "severity": "medium" },
    { "name": "GIT_ASKPASS", "severity": "medium" },
    { "name": "GIT_EXEC_PATH", "severity": "medium" },
    { "name": "HTTP_PROXY", "severity": "medium" },
    { "name": "HTTPS_PROXY", "severity": "medium" },
    { "name": "ALL_PROXY", "severity": "medium" },
    { "name": "NPM_CONFIG_REGISTRY", "severity": "medium" },
    { "name": "PIP_INDEX_URL", "severity": "medium" },
    { "name": "PIP_EXTRA_INDEX_URL", "severity": "medium" },
    { "name": "UV_INDEX_URL", "severity": "medium" },
    { "name": "PATH", "severity": "medium", "lowIf": "^\\s*\\$\\{env:path\\}" }
  ],

  "workspaceExecPathSettings": [
    "python.defaultInterpreterPath", "python.pythonPath", "python.condaPath", "python.poetryPath", "python.pipenvPath",
    "git.path", "eslint.nodePath", "eslint.runtime", "prettier.prettierPath", "typescript.tsdk", "php.validate.executablePath",
    "go.alternateTools", "go.goroot", "rust-analyzer.server.path", "clangd.path", "java.jdt.ls.java.home", "java.home",
    "deno.path", "powershell.powerShellAdditionalExePaths", "terminal.external.windowsExec", "cmake.cmakePath",
    "makefile.makePath", "debug.javascript.defaultRuntimeExecutable", "jest.jestCommandLine", "biome.lspBin", "ruff.path"
  ],

  "autoRunOnOpenSettings": [
    { "key": "makefile.configureOnOpen", "value": true, "extension": "ms-vscode.makefile-tools", "note": "Makefile Tools runs 'make --dry-run' when a folder opens; GNU make still evaluates $(shell ...) calls in a Makefile during a dry run." },
    { "key": "cmake.configureOnOpen", "value": true, "extension": "ms-vscode.cmake-tools", "note": "CMake Tools runs a CMake configure when a folder opens; CMakeLists.txt can run execute_process()." }
  ],

  "chatAutoApproveKeys": ["chat.tools.autoApprove", "chat.tools.global.autoApprove", "chat.tools.terminal.autoApprove", "chat.agent.terminal.autoApprove", "chat.tools.urls.autoApprove", "chat.tools.edits.autoApprove"],

  "aiRulesFiles": [".cursorrules", ".windsurfrules", ".clinerules", ".github\\copilot-instructions.md"],
  "aiRulesDirs": [".cursor\\rules", ".clinerules", ".github\\instructions", ".github\\prompts", ".windsurf\\rules"],

  "git": {
    "trustedHosts": ["github.com", "gist.github.com", "gitlab.com", "bitbucket.org", "dev.azure.com", "ssh.dev.azure.com", "vs-ssh.visualstudio.com", "codeberg.org", "gitea.com", "huggingface.co", "git.sr.ht", "sourceforge.net", "aur.archlinux.org"],
    "trustedHostSuffixes": [".visualstudio.com", ".github.com", ".gitlab.com"],
    "okCredentialHelpers": ["manager", "manager-core", "wincred", "cache", "osxkeychain", "libsecret", ""],
    "expectedValues": [
      { "key": "filter.lfs.clean", "regex": "^git-lfs clean" },
      { "key": "filter.lfs.smudge", "regex": "^git-lfs smudge" },
      { "key": "filter.lfs.process", "regex": "^git-lfs filter-process" },
      { "key": "diff.astextplain.textconv", "regex": "^astextplain$" }
    ],
    "benignExecValues": "^(?:\"?(?:vim?|nvim|nano|emacs|notepad(?:\\+\\+)?(?:\\.exe)?|code(?:-insiders)?|cursor|subl|less|more|cat|delta|diff-so-fancy|bat|ssh(?:\\.exe)?|plink(?:\\.exe)?|tortoiseplink(?:\\.exe)?|gpg(?:\\.exe)?|gpg2|true)\"?)(?:\\s+(?:--wait|-w|-R|-FRX|-F|-X|--paging=\\S+|-i\\s+\\S+|-o\\s+\\S+|-p\\s+\\d+))*\\s*$",
    "expectedHookSignatures": [
      { "name": "git-lfs", "regex": "git lfs (?:pre-push|post-checkout|post-commit|post-merge)\\b" },
      { "name": "husky", "regex": "husky" },
      { "name": "pre-commit", "regex": "File generated by pre-commit" },
      { "name": "lefthook", "regex": "\\blefthook\\b" },
      { "name": "yorkie", "regex": "\\byorkie\\b" },
      { "name": "overcommit", "regex": "\\bovercommit\\b" },
      { "name": "git-secrets", "regex": "git secrets --(?:pre_commit_hook|commit_msg_hook|prepare_commit_msg_hook)" },
      { "name": "talisman", "regex": "\\btalisman\\b" },
      { "name": "gitleaks", "regex": "\\bgitleaks\\b" },
      { "name": "ggshield", "regex": "\\bggshield\\b" }
    ],
    "huskyHooksPath": "^\\.husky(?:[\\\\/]_)?[\\\\/]?$",
    "envVars": ["GIT_SSH", "GIT_SSH_COMMAND", "GIT_ASKPASS", "SSH_ASKPASS", "GIT_EDITOR", "GIT_SEQUENCE_EDITOR", "GIT_PAGER", "GIT_EXTERNAL_DIFF", "GIT_PROXY_COMMAND", "GIT_EXEC_PATH", "GIT_TEMPLATE_DIR", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_SSL_NO_VERIFY", "GIT_TRACE", "GIT_CURL_VERBOSE"]
  },

  "jetbrains": {
    "startupComponentRegex": "<component\\s+name=\"ProjectStartup(?:Shared|Local)?Configuration\"",
    "shellRunConfigRegex": "type=\"(?:ShConfigurationType|BatchConfigurationType|PowerShellRunType)\""
  }
