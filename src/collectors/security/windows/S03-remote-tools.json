{
  "schema": "bvs.remote-tools/1",
  "updated": "2026-10-20",
  "description": "Remote-control, RMM, RAT-abused remote-support, tunnel, VPN-overlay and game-stream host tools. Generic product knowledge (not machine-specific). Used by S03 (Windows) and intended for the Linux collector. Windows matching: exe/clientExe/files = file names (case-insensitive, * wildcards); service = regex on service Name or DisplayName; product = regex on uninstall DisplayName; publisher = regex on uninstall Publisher; folder = regex on folder leaf names at level 1-2 below Program Files, ProgramData and AppData (folderRoots/folderLevel restrict it); paths = specific locations (environment variables allowed); sweep=false keeps generic names out of the portable-binary file sweep. clientExe = viewer/technician consoles (this PC controls others, not the reverse). Process matching uses executable names only, never command lines, so a folder or virtual machine that shares a tool's name is not reported.",
  "categories": {
    "rmm": "Remote monitoring and management agent (unattended access, script execution)",
    "remote-support": "Attended/unattended remote-desktop support tool, heavily abused by tech-support scammers and intrusion crews",
    "remote-desktop": "Remote desktop server (VNC family, Radmin, Chrome Remote Desktop)",
    "rat-abused": "Legitimate product that is a common RAT payload (NetSupport via ClickFix)",
    "tunnel": "Reverse tunnel / port forwarder that can expose the PC or bypass the firewall",
    "vpn-overlay": "Overlay VPN that puts the PC on another network",
    "game-stream": "Game-streaming host that gives full remote keyboard/mouse control",
    "oem-remote": "OEM cross-device screen sharing / remote control feature"
  },
  "references": [
    "https://lolrmm.io (LOLRMM community catalog of RMM tools; candidate intel source for v2)",
    "https://attack.mitre.org/techniques/T1219/",
    "https://attack.mitre.org/techniques/T1572/"
  ],
