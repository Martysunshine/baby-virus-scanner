  "lookalike": {
    "note": "Names compared without .exe, lower-case. 'protected' = names worth impersonating; a candidate is a look-alike when its homoglyph skeleton equals a protected skeleton, or its Damerau-Levenshtein distance to a protected name of length >= minLength is 1. 'allow' = real Windows/vendor names that are near-misses.",
    "protected": ["svchost", "lsass", "csrss", "winlogon", "services", "smss", "wininit", "explorer", "rundll32", "dllhost", "conhost", "taskhostw", "runtimebroker", "spoolsv", "searchindexer", "lsaiso", "sihost", "ctfmon", "fontdrvhost", "userinit", "wmiprvse", "audiodg", "searchprotocolhost", "backgroundtaskhost", "powershell", "regsvr32", "taskmgr"],
    "minLength": 5,
    "allow": ["sihost", "lsaiso", "taskhost", "taskhostex", "iexplore", "dllhst3g", "lsm", "csrsrv", "wlanext", "dashost", "smartscreen", "services", "service", "explore", "powershell_ise", "conhostv1", "pwsh", "spoolss", "userinit", "ctfmon"],
