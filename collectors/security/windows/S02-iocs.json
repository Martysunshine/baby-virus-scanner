  "shellHosts": ["cmd.exe", "powershell.exe", "pwsh.exe", "powershell_ise.exe", "wscript.exe", "cscript.exe", "mshta.exe", "conhost.exe", "openconsole.exe"],
  "commandLinePatterns": [
    { "id": "ps_encoded_command", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["obfuscation", "encoded_command"], "mitre": ["T1059.001", "T1027"],
      "regex": "(?i)(?:^|\\s)[-/]e(?:c|n|nc|nco|ncod|ncode|ncoded|ncodedc|ncodedco|ncodedcom|ncodedcomm|ncodedcomma|ncodedcomman|ncodedcommand)?\\s+['\"]?[A-Za-z0-9+/]{16,}={0,2}" },
    { "id": "ps_hidden_window", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "medium", "reasons": ["hidden"], "mitre": ["T1564.003"],
      "regex": "(?i)(?:^|\\s)[-/]w(?:i|in|ind|indo|indow|indows|indowst|indowsty|indowstyl|indowstyle)?\\s+['\"]?(?:h|hi|hid|hidd|hidde|hidden|1)['\"]?(?=\\s|$)" },
    { "id": "ps_iex", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["obfuscation", "lolbin"], "mitre": ["T1059.001"],
      "regex": "(?i)(?:^|[\\s;|('\"{&])(?:iex|invoke-expression)(?=$|[\\s;|('\"(&])" },
    { "id": "ps_download_cradle", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1105", "T1059.001"],
      "regex": "(?i)\\.Download(?:String|File|Data)(?:Async)?\\s*\\(|Net\\.WebClient|Start-BitsTransfer|(?:\\biwr|\\birm|\\bcurl|\\bwget|Invoke-WebRequest|Invoke-RestMethod)\\b[^|]{0,300}\\|\\s*(?:iex|invoke-expression)\\b" },
    { "id": "ps_frombase64", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["obfuscation"], "mitre": ["T1027", "T1140"],
      "regex": "(?i)FromBase64String" },
    { "id": "ps_reflection_load", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["obfuscation"], "mitre": ["T1620"],
      "regex": "(?i)\\[(?:System\\.)?Reflection\\.Assembly\\]::Load" },
    { "id": "defender_tamper", "hosts": ["powershell.exe", "pwsh.exe", "powershell_ise.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1562.001"],
      "regex": "(?i)Add-MpPreference\\b.{0,200}-Exclusion|Set-MpPreference\\b.{0,200}-Disable" },
    { "id": "mshta_remote", "hosts": ["mshta.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1218.005"],
      "regex": "(?i)mshta(?:\\.exe)?['\"]?\\s+['\"]?(?:https?:|javascript:|vbscript:|about:)" },
    { "id": "regsvr32_remote", "hosts": ["regsvr32.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1218.010"],
      "regex": "(?i)/i:\\s*['\"]?(?:https?:|\\\\\\\\)|scrobj\\.dll" },
    { "id": "rundll32_script", "hosts": ["rundll32.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1218.011"],
      "regex": "(?i)javascript:|vbscript:|mshtml(?:\\.dll)?['\"]?\\s*,\\s*#?\\s*RunHTMLApplication" },
    { "id": "certutil_download", "hosts": ["certutil.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1105", "T1140"],
      "regex": "(?i)(?:^|\\s)[-/](?:urlcache|verifyctl|decode|decodehex)\\b" },
    { "id": "bitsadmin_transfer", "hosts": ["bitsadmin.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1197"],
      "regex": "(?i)/(?:transfer|addfile|create|setnotifycmdline|resume|complete)\\b" },
    { "id": "bitsadmin_any", "hosts": ["bitsadmin.exe"], "severity": "medium", "reasons": ["lolbin"], "mitre": ["T1197"],
      "regex": "(?i)bitsadmin" },
    { "id": "msiexec_remote", "hosts": ["msiexec.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1218.007"],
      "regex": "(?i)(?:^|\\s)/(?:i|package|fa?|x)\\s*['\"]?https?:" },
    { "id": "wmic_process_create", "hosts": ["wmic.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1047"],
      "regex": "(?i)process\\s+call\\s+create" },
    { "id": "shadow_copy_delete", "hosts": ["vssadmin.exe", "wmic.exe", "wbadmin.exe"], "severity": "high", "reasons": ["lolbin"], "mitre": ["T1490"],
      "regex": "(?i)delete\\s+shadows|shadowcopy\\s+delete|delete\\s+catalog" },
    { "id": "miner_markers", "hosts": ["*"], "severity": "high", "reasons": ["intel_match"], "mitre": ["T1496"],
      "regex": "(?i)stratum\\+(?:tcp|ssl|tls)://|--donate-level|\\bcryptonight\\b|--algo[= ](?:rx/|cn/|kawpow|ethash|randomx)|\\bxmrig\\b|\\bminexmr\\b|\\bmoneroocean\\b|\\bsupportxmr\\b|\\bnanopool\\.org\\b|\\bunmineable\\b" }
