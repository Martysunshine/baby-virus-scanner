  "githubKnownOwners": ["microsoft", "PowerShell", "MicrosoftDocs", "Azure", "dotnet", "MicrosoftEdge", "ScoopInstaller", "chocolatey", "JanDeDobbeleer", "astral-sh", "oven-sh", "pnpm", "ollama", "denoland", "rust-lang", "nvm-sh", "coreybutler", "anthropics", "openai", "docker", "tailscale", "nodejs", "python", "pypa", "git-for-windows", "cli", "github", "Homebrew", "ohmyzsh", "starship", "junegunn", "ajeetdsouza", "sharkdp", "BurntSushi", "Schniz", "volta-cli", "pyenv-win", "pyenv", "conda", "conda-forge", "mamba-org", "golang", "kubernetes", "helm", "hashicorp", "aws", "awslabs", "google", "GoogleCloudPlatform", "vercel", "nvm-windows", "winget-pkgs", "mozilla", "denisidoro", "eza-community", "jesseduffield", "gitleaks", "trufflesecurity", "aquasecurity", "anchore", "sigstore"],
  "updateHosts": ["microsoft.com", "windowsupdate.com", "windows.com", "msn.com", "live.com", "live.net", "office.com", "office.net", "office365.com", "microsoftonline.com", "bing.com", "bing.net", "msedge.net", "sfx.ms", "onedrive.com", "skype.com", "xboxlive.com", "s-microsoft.com", "visualstudio.com", "vsassets.io", "msecnd.net", "aka.ms", "google.com", "gvt1.com", "gvt2.com", "adobe.com", "avast.com", "avcdn.net", "gendigital.com", "norton.com", "avg.com", "ccleaner.com", "mozilla.org", "mozilla.net", "spotify.com", "scdn.co", "spotifycdn.com", "zoom.us", "zoom.com", "asus.com", "asus.com.cn", "nvidia.com", "intel.com", "amd.com", "realtek.com", "dell.com", "hp.com", "lenovo.com", "epson.com", "epson.net", "logitech.com", "logi.com", "apple.com", "webex.com", "cisco.com", "loom.com", "safeexambrowser.org"],
  "proxyModifyingApps": ["netsh.exe", "powershell.exe", "pwsh.exe", "wmiprvse.exe", "mmc.exe", "SystemSettingsAdminFlows.exe", "cmd.exe", "rundll32.exe", "dllhost.exe"],
  "benignWmiConsumers": ["NTEventLogEventConsumer=\"SCM Event Log Consumer\""],
  "runOnceSelfDeletingPatterns": ["OneDriveSetup\\.exe", "--on-logon\\b", "--configure-user-settings\\b", "--delete-old-versions\\b", "\\bchrmstp\\.exe", "\\bie4uinit\\.exe", "\\bsetup\\.exe\"?\\s+--(?:msedge|msedgewebview|chrome)", "MicrosoftEdgeUpdate", "GoogleUpdaterSetup", "\\b(?:msiexec|MsiExec)(?:\\.exe)?\\s+/", "\\bDismHost\\b", "\\bsdbinst\\b", "/firstrun\\b", "\\bUninst", "\\bdel\\s+/[a-z]"],
  "watchedServices": ["WinDefend", "WdNisSvc", "WdFilter", "WdBoot", "WdNisDrv", "Sense", "SecurityHealthService", "wscsvc", "MpsSvc", "BFE", "EventLog", "wuauserv", "UsoSvc", "WaaSMedicSvc"],
