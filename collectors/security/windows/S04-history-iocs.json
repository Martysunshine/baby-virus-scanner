{
  "schema": "bvs.s04-iocs/1",
  "description": "Data for S04 (command history & event logs). Command-line IoC patterns (ClickFix / FileFix / download cradles / LOLBins / obfuscation), installer-domain allowlist, GitHub owner allowlist, vendor update hosts for BITS, benign WMI consumers, self-deleting RunOnce patterns and watched services. Generic (not machine-specific): machine-specific known-good items live in config\\local\\expected.json. Regexes use the common .NET/Python subset so a Linux collector can reuse this file. Matching is case-insensitive.",
  "weights": { "strong": 3, "medium": 2, "weak": 1 },
  "commandPatterns": [
    { "id": "irm_pipe_iex", "category": "download_exec", "weight": 3, "mitre": ["T1059.001", "T1105"], "description": "Web request piped into Invoke-Expression (irm|iex, iwr|iex)",
      "regex": "\\b(?:irm|iwr|Invoke-RestMethod|Invoke-WebRequest|curl(?:\\.exe)?|wget(?:\\.exe)?)\\b[^|\\r\\n]*\\|\\s*(?:iex|Invoke-Expression)\\b" },
    { "id": "iex_of_download", "category": "download_exec", "weight": 3, "mitre": ["T1059.001", "T1105"], "description": "Invoke-Expression wrapped around a web request or WebClient",
      "regex": "\\b(?:iex|Invoke-Expression)\\b\\s*\\(?\\s*(?:\\(\\s*)*(?:irm|iwr|Invoke-RestMethod|Invoke-WebRequest|curl|wget|New-Object\\s+(?:System\\.)?Net\\.WebClient|\\[(?:System\\.)?Net\\.WebClient\\])\\b" },
    { "id": "downloadstring_iex", "category": "download_exec", "weight": 3, "mitre": ["T1059.001", "T1105"], "description": "WebClient.DownloadString/DownloadData combined with Invoke-Expression",
      "regex": "\\b(?:iex|Invoke-Expression)\\b[^\\r\\n]*\\.Download(?:String|Data)(?:Async|TaskAsync)?\\s*\\(|\\.Download(?:String|Data)(?:Async|TaskAsync)?\\s*\\([^\\r\\n]*\\b(?:iex|Invoke-Expression)\\b" },
    { "id": "scriptblock_of_download", "category": "download_exec", "weight": 3, "mitre": ["T1059.001", "T1105"], "description": "[scriptblock]::Create() around downloaded content",
      "regex": "\\[scriptblock\\]::create\\s*\\(\\s*(?:\\(\\s*)*(?:irm|iwr|Invoke-RestMethod|Invoke-WebRequest|curl|\\(?\\s*New-Object\\s+(?:System\\.)?Net\\.WebClient)" },
    { "id": "curl_pipe_shell", "category": "download_exec", "weight": 3, "mitre": ["T1059.004", "T1105"], "description": "curl/wget piped into a shell or interpreter (curl ... | bash/sh)",
      "regex": "\\b(?:curl|wget)(?:\\.exe)?\\b[^|\\r\\n]*\\|\\s*(?:sudo\\s+(?:-\\S+\\s+)*)?(?:(?:ba|z|da|k|fi)?sh|python3?|node|perl|ruby|pwsh|powershell|cmd)(?:\\.exe)?\\b|\\b(?:ba|z|da)?sh\\s+(?:-c\\s+)?[\"']?\\$\\(\\s*(?:curl|wget)\\b|\\b(?:ba|z|da)?sh\\s+<\\(\\s*(?:curl|wget)\\b" },
    { "id": "download_then_run", "category": "download_exec", "weight": 2, "mitre": ["T1105", "T1204.002"], "description": "Download of an executable/script followed by running it on the same line",
      "regex": "^(?=.*(?:\\b(?:irm|iwr|Invoke-RestMethod|Invoke-WebRequest|curl(?:\\.exe)?|wget(?:\\.exe)?|Start-BitsTransfer)\\b|\\.DownloadFile(?:Async|TaskAsync)?\\s*\\())(?=.*\\.(?:exe|msi|ps1|bat|cmd|vbs|js|hta|scr|dll|cpl)\\b)(?=.*(?:\\bStart-Process\\b|(?:^|[;&|]\\s*)&\\s*[\"'$]|(?:^|[;&|]\\s*)\\.\\\\|\\bmsiexec\\b|\\bcmd(?:\\.exe)?\\s+/c\\b|\\brundll32\\b|\\bregsvr32\\b|\\bInvoke-Item\\b|(?:^|[;&|]\\s*)start\\s+))" },
    { "id": "mshta_url", "category": "lolbin", "weight": 3, "mitre": ["T1218.005"], "description": "mshta with a remote URL or inline script",
      "regex": "\\bmshta(?:\\.exe)?[\"']?\\s+[\"']?(?:https?|ftp)://|\\bmshta(?:\\.exe)?[\"']?\\s+[\"']?(?:javascript|vbscript):" },
    { "id": "msiexec_url", "category": "lolbin", "weight": 3, "mitre": ["T1218.007"], "description": "msiexec installing directly from a URL",
      "regex": "\\bmsiexec(?:\\.exe)?\\b[^\\r\\n]{0,100}?(?:https?|ftp)://" },
    { "id": "conhost_headless", "category": "lolbin", "weight": 3, "mitre": ["T1202", "T1564.003"], "description": "conhost --headless (hidden console proxy execution)",
      "regex": "\\bconhost(?:\\.exe)?[\"']?\\s+--headless\\b" },
    { "id": "finger", "category": "lolbin", "weight": 3, "mitre": ["T1105"], "description": "finger user@host used to fetch a payload (ClickFix 2025 variant)",
      "regex": "\\bfinger(?:\\.exe)?\\s+[^\\s|;]*@[^\\s|;]+" },
    { "id": "certutil_urlcache", "category": "lolbin", "weight": 3, "mitre": ["T1105"], "description": "certutil -urlcache / -verifyctl download",
      "regex": "\\bcertutil(?:\\.exe)?\\b[^\\r\\n]{0,100}?[-/](?:urlcache|verifyctl)\\b" },
    { "id": "certutil_decode", "category": "lolbin", "weight": 2, "mitre": ["T1140"], "description": "certutil -decode / -decodehex",
      "regex": "\\bcertutil(?:\\.exe)?\\b[^\\r\\n]{0,100}?[-/]decode(?:hex)?\\b" },
    { "id": "bitsadmin", "category": "lolbin", "weight": 2, "mitre": ["T1197"], "description": "bitsadmin (download / persistence via BITS jobs)",
      "regex": "\\bbitsadmin(?:\\.exe)?\\b" },
    { "id": "rundll32_unc", "category": "lolbin", "weight": 3, "mitre": ["T1218.011"], "description": "rundll32 loading a DLL from a UNC/WebDAV path or running inline script",
      "regex": "\\brundll32(?:\\.exe)?[\"']?\\s+[\"']?\\\\\\\\[^\\\\\\s]+\\\\|\\brundll32(?:\\.exe)?[^\\r\\n]{0,60}(?:javascript|vbscript):" },
    { "id": "webdav_unc", "category": "lolbin", "weight": 3, "mitre": ["T1218", "T1105"], "description": "WebDAV UNC path (\\\\host@SSL\\..., DavWWWRoot)",
      "regex": "\\\\\\\\[A-Za-z0-9.\\-]+@SSL(?:@\\d+)?\\\\|\\\\DavWWWRoot\\\\|\\\\\\\\[A-Za-z0-9.\\-]+@\\d{2,5}\\\\" },
    { "id": "nslookup_stage", "category": "lolbin", "weight": 3, "mitre": ["T1071.004", "T1105"], "description": "nslookup used to stage a payload (TXT query or output piped to an interpreter)",
      "regex": "\\bnslookup(?:\\.exe)?\\b[^\\r\\n]{0,120}?(?:-q(?:uerytype)?=txt\\b|\\|\\s*(?:findstr|iex|Invoke-Expression|powershell|pwsh|cmd)\\b)" },
    { "id": "lolbin_misc", "category": "lolbin", "weight": 2, "mitre": ["T1218"], "description": "Other proxy-execution LOLBins (regsvr32 /i:http, scrobj, wmic process call create, cmstp, pcalua, forfiles, msbuild from temp, InstallUtil /u, odbcconf, msxsl)",
      "regex": "\\bregsvr32(?:\\.exe)?\\b[^\\r\\n]{0,80}/i:\\s*(?:https?|\\\\\\\\)|\\bregsvr32(?:\\.exe)?\\b[^\\r\\n]{0,80}scrobj\\.dll|\\bwmic(?:\\.exe)?\\b[^\\r\\n]{0,80}\\bprocess\\s+call\\s+create\\b|\\bcmstp(?:\\.exe)?\\b[^\\r\\n]{0,40}/s\\b|\\bpcalua(?:\\.exe)?\\s+-a\\b|\\bforfiles(?:\\.exe)?\\b[^\\r\\n]{0,120}/c\\b|\\bmsbuild(?:\\.exe)?\\b[^\\r\\n]{0,120}\\\\(?:temp|appdata|downloads|public)\\\\|\\bInstallUtil(?:\\.exe)?\\b[^\\r\\n]{0,80}/u\\b|\\bodbcconf(?:\\.exe)?\\b[^\\r\\n]{0,60}/a\\b|\\bmsxsl(?:\\.exe)?\\b" },
    { "id": "encoded_command", "category": "encoded_command", "weight": 3, "mitre": ["T1027", "T1140", "T1059.001"], "description": "PowerShell -EncodedCommand / -enc / -e with a base64 argument",
      "requires": "\\b(?:powershell|pwsh)(?:\\.exe)?\\b",
      "regex": "(?:^|\\s)[-/]e(?:c|n|nc|nco|ncod|ncode|ncoded|ncodedc|ncodedco|ncodedcom|ncodedcomm|ncodedcomma|ncodedcomman|ncodedcommand)?\\s+[\"']?[A-Za-z0-9+/]{20,}={0,2}" },
    { "id": "encoded_command_full", "category": "encoded_command", "weight": 3, "mitre": ["T1027", "T1140", "T1059.001"], "description": "-EncodedCommand spelled out",
      "regex": "(?:^|\\s)-EncodedCommand\\s+\\S{8,}" },
    { "id": "hidden_window", "category": "hidden", "weight": 1, "mitre": ["T1564.003"], "description": "-w h / -WindowStyle Hidden",
      "regex": "(?:^|[\\s\"'])-w(?:i|in|ind|indo|indow|indows|indowst|indowsty|indowstyl|indowstyle)?\\s+[\"']?h(?:i|id|idd|idde|idden)?[\"']?(?=$|[\\s;|)\"'])" },
    { "id": "iex", "category": "exec", "weight": 1, "mitre": ["T1059.001"], "description": "Invoke-Expression / iex / [scriptblock]::Create (alone: weak)",
      "regex": "\\b(?:iex|Invoke-Expression)\\b|\\[scriptblock\\]::create\\s*\\(|\\.InvokeScript\\s*\\(" },
    { "id": "download_api", "category": "download", "weight": 1, "mitre": ["T1105"], "description": "DownloadString / DownloadFile / DownloadData / Net.WebClient / Start-BitsTransfer (alone: weak)",
      "regex": "\\.Download(?:String|File|Data)(?:Async|TaskAsync)?\\s*\\(|\\bNet\\.WebClient\\b|\\bStart-BitsTransfer\\b" },
    { "id": "frombase64", "category": "obfuscation", "weight": 1, "mitre": ["T1140"], "description": "FromBase64String (alone: weak)",
      "regex": "FromBase64String\\s*\\(" },
    { "id": "compressed_payload", "category": "obfuscation", "weight": 3, "mitre": ["T1027", "T1140"], "description": "Base64 + Gzip/Deflate stream (packed in-memory payload)",
      "regex": "(?:GzipStream|DeflateStream)[^\\r\\n]{0,300}FromBase64String|FromBase64String[^\\r\\n]{0,300}(?:GzipStream|DeflateStream)" },
    { "id": "char_obfuscation", "category": "obfuscation", "weight": 2, "mitre": ["T1027.010"], "description": "[char] arithmetic, -join of char codes, -bxor, backtick-split keywords, -f format reassembly",
      "regex": "(?:\\[char\\]\\s*\\(?\\s*(?:0x[0-9a-f]{2}|\\d{2,3})\\s*\\)?\\s*[+,]\\s*){4,}|-join\\s*\\(?\\s*\\(?\\s*(?:\\d{2,3}\\s*,\\s*){4,}|-bxor\\s*(?:0x[0-9a-f]+|\\d+)|\\b[a-z]{1,4}`[a-z]{1,4}`[a-z]{1,6}\\b|\\(\\s*[\"']\\{\\d\\}\\{\\d\\}(?:\\{\\d\\})+[\"']\\s*-f\\b" },
    { "id": "amsi_bypass", "category": "defense_evasion", "weight": 3, "mitre": ["T1562.001"], "description": "AMSI bypass strings",
      "regex": "\\bAmsiUtils\\b|\\bamsiInitFailed\\b|\\bAmsiScanBuffer\\b|\\bamsiContext\\b|\\bAmsiOpenSession\\b" },
    { "id": "defender_tamper", "category": "defense_evasion", "weight": 3, "mitre": ["T1562.001"], "description": "Add-MpPreference -Exclusion*, Set-MpPreference -Disable*, Defender policy disable values, MpCmdRun -RemoveDefinitions, sc stop WinDefend",
      "regex": "\\b(?:Add|Set)-MpPreference\\b[^\\r\\n]{0,200}?-(?:Exclusion\\w*|Disable\\w+)\\b|\\bDisable(?:AntiSpyware|AntiVirus|RealtimeMonitoring|BehaviorMonitoring|IOAVProtection|ScriptScanning|IntrusionPreventionSystem|BlockAtFirstSeen)\\b|\\bMpCmdRun(?:\\.exe)?\\b[^\\r\\n]{0,80}?-RemoveDefinitions\\b|\\bsc(?:\\.exe)?\\s+(?:stop|config|delete)\\s+WinDefend\\b|\\bSet-MpPreference\\b[^\\r\\n]{0,200}?-(?:MAPSReporting|SubmitSamplesConsent)\\s+(?:0|Disabled|NeverSend|2)\\b" },
    { "id": "reflection_load", "category": "execution", "weight": 2, "mitre": ["T1620"], "description": "In-memory .NET assembly load",
      "regex": "\\[(?:System\\.)?Reflection\\.Assembly\\]::Load(?:File|From)?\\s*\\(|\\[AppDomain\\]::CurrentDomain\\.Load\\s*\\(" },
    { "id": "captcha_lure", "category": "lure", "weight": 3, "mitre": ["T1204.004"], "description": "ClickFix captcha lure text (I am not a robot, Ray ID, reCAPTCHA, human verification, check marks)",
      "regex": "\\bI\\s*(?:'|\u2019)?\\s*a?m\\s+not\\s+a\\s+robot\\b|\\bRay\\s*ID\\b|\\bre-?CAPTCHA\\b|\\bcaptcha\\b|\\bverify\\s+(?:that\\s+)?you\\s+are\\s+(?:a\\s+)?human\\b|\\bhuman\\s+verification\\b|\\bverification\\s+(?:id|code|hash|step|complete|completed|successful|passed)\\b|\u2705|\u2714" },
    { "id": "verification_comment", "category": "lure", "weight": 2, "mitre": ["T1204.004"], "description": "Comment pairing verify/verification with captcha vocabulary (ClickFix decoy comment such as '# Cloudflare verification ID: 4821')",
      "regex": "#[^\\r\\n]*\\bverif(?:y|ied|ication)\\b[^\\r\\n]*\\b(?:id|code|hash|captcha|robot|human|cloudflare|ray)\\b|#[^\\r\\n]*\\b(?:captcha|robot|human|cloudflare|ray)\\b[^\\r\\n]*\\bverif(?:y|ied|ication)\\b" },
    { "id": "verification_word", "category": "lure", "weight": 1, "mitre": ["T1204.004"], "description": "The word 'verification' (weak alone)",
      "regex": "\\bverification\\b" },
    { "id": "whitespace_padding", "category": "lure", "weight": 2, "mitre": ["T1204.004", "T1027"], "description": "FileFix padding: 40+ spaces before a comment, a padded comment that looks like a document path, or runs of unusual Unicode spaces",
      "regex": "\\S[ \\t\u00a0\u2000-\u200b\u3000]{40,}#|[ \\t\u00a0\u2000-\u200b\u3000]{8,}#\\s*(?:[A-Za-z]:\\\\|\\\\\\\\)[^\\r\\n]*\\.(?:docx?|xlsx?|pptx?|pdf|txt|csv|rtf)\\b|[\u00a0\u2000-\u200b\u3000\u202f\u205f\ufeff]{3,}" },
    { "id": "offensive_tool", "category": "offensive", "weight": 2, "mitre": ["T1588.002"], "description": "Offensive-security tooling names",
      "regex": "\\b(?:Invoke-Mimikatz|mimikatz|sekurlsa|Invoke-Shellcode|PowerSploit|Invoke-ReflectivePEInjection|PowerView|SharpHound|BloodHound|Rubeus|Invoke-Kerberoast|Invoke-PowerShellTcp|nishang|PowerUp\\.ps1|Get-GPPPassword|Invoke-SMBExec|Invoke-WMIExec|Invoke-TheHash|meterpreter|msfvenom|Invoke-DCSync|lsassy)\\b|\\bprocdump(?:64)?(?:\\.exe)?\\b[^\\r\\n]{0,40}\\blsass\\b|\\bcomsvcs(?:\\.dll)?\\b[^\\r\\n]{0,40}MiniDump" },
    { "id": "persistence_cmd", "category": "persistence", "weight": 2, "mitre": ["T1053.005", "T1547.001", "T1543.003", "T1546.003"], "description": "Scheduled task / service / Run-key / WMI-subscription creation",
      "regex": "\\bschtasks(?:\\.exe)?\\s+/create\\b|\\bRegister-ScheduledTask\\b|\\bNew-Service\\b|\\bsc(?:\\.exe)?\\s+create\\b|\\breg(?:\\.exe)?\\s+add\\s+[\"']?HK(?:CU|LM|EY_CURRENT_USER|EY_LOCAL_MACHINE)\\\\Software\\\\(?:WOW6432Node\\\\)?Microsoft\\\\Windows\\\\CurrentVersion\\\\Run(?:Once)?\\b|(?:Set|New)-ItemProperty\\b[^\\r\\n]{0,200}CurrentVersion\\\\Run(?:Once)?\\b|\\bwmic(?:\\.exe)?\\b[^\\r\\n]{0,80}\\b(?:__EventFilter|CommandLineEventConsumer)\\b|\\bSet-WmiInstance\\b[^\\r\\n]{0,120}__EventFilter" },
    { "id": "exec_policy_bypass", "category": "weak", "weight": 1, "mitre": ["T1059.001"], "description": "-ExecutionPolicy Bypass / Set-ExecutionPolicy Bypass (very common in installers: weak)",
      "regex": "(?:^|\\s)-(?:ep|ex|exec|executionpolicy)\\s+[\"']?(?:bypass|unrestricted)\\b|\\bSet-ExecutionPolicy\\b[^\\r\\n]{0,60}\\b(?:Bypass|Unrestricted)\\b" }
  ],
  "strongCategories": ["download_exec", "lolbin", "encoded_command", "defense_evasion", "lure"],
  "downloadVerbs": ["irm", "iwr", "Invoke-RestMethod", "Invoke-WebRequest", "curl", "curl.exe", "wget", "wget.exe", "Start-BitsTransfer"],
  "downloadValueParams": ["-Method", "-Headers", "-H", "--header", "-OutFile", "-o", "-O", "--output", "-A", "--user-agent", "-UserAgent", "-X", "--request", "-d", "--data", "-u", "--user", "-ContentType", "-Body", "-TimeoutSec", "-Proxy", "-Credential", "-SessionVariable", "-WebSession", "-MaximumRedirection", "-Destination", "-e", "--referer", "-w", "--write-out", "-m", "--max-time", "--connect-timeout", "-r", "--retry", "-T"],
  "downloadUrlParams": ["-Uri", "-Source", "--url", "-url"],
  "installerDomains": ["claude.ai", "community.chocolatey.org", "chocolatey.org", "get.scoop.sh", "astral.sh", "bun.sh", "ohmyposh.dev", "get.pnpm.io", "ollama.com", "aka.ms", "dot.net", "deno.land", "rustup.rs", "tailscale.com", "docker.com", "nodejs.org", "python.org"],
