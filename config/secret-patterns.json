{
  "version": 1,
  "description": "Secret masking rules (fail-closed). Ordered: private keys, prefixed tokens, context rules, generic assignment. Derived from common secret-scanner rules plus host-forensics rules. group = capture group holding the secret (0 = whole match).",
  "rules": [
    { "id": "pem-private-key-block", "kind": "private-key", "group": 0, "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----" },
    { "id": "pem-private-key-header", "kind": "private-key", "group": 0, "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----[A-Za-z0-9+/=\\\\\\s]{0,8192}" },
    { "id": "putty-private-key", "kind": "private-key", "group": 0, "regex": "PuTTY-User-Key-File-\\d:[\\s\\S]{0,8192}?Private-MAC:\\s*[0-9a-f]+" },
    { "id": "npm-token", "kind": "token", "group": 0, "regex": "\\bnpm_[A-Za-z0-9]{36}\\b" },
    { "id": "github-token", "kind": "token", "group": 0, "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}\\b" },
    { "id": "github-fine-grained-pat", "kind": "token", "group": 0, "regex": "\\bgithub_pat_[A-Za-z0-9_]{40,}\\b" },
    { "id": "anthropic-key", "kind": "token", "group": 0, "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}" },
    { "id": "openai-key", "kind": "token", "group": 0, "regex": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_\\-]{32,}" },
    { "id": "stripe-key", "kind": "token", "group": 0, "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}" },
    { "id": "stripe-webhook-secret", "kind": "token", "group": 0, "regex": "\\bwhsec_[A-Za-z0-9]{20,}" },
    { "id": "slack-token", "kind": "token", "group": 0, "regex": "\\bxox[abposr]-[A-Za-z0-9\\-]{10,}" },
    { "id": "slack-webhook", "kind": "webhook", "group": 0, "regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_\\-]{20,}" },
    { "id": "discord-webhook", "kind": "webhook", "group": 0, "regex": "https://(?:canary\\.|ptb\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_\\-]{20,}" },
    { "id": "discord-bot-token", "kind": "token", "group": 0, "regex": "\\b[MNO][A-Za-z\\d_\\-]{23,25}\\.[A-Za-z\\d_\\-]{6}\\.[A-Za-z\\d_\\-]{27,}\\b" },
    { "id": "telegram-bot-token", "kind": "token", "group": 0, "regex": "\\b\\d{8,10}:[A-Za-z0-9_\\-]{35}\\b" },
    { "id": "google-api-key", "kind": "token", "group": 0, "regex": "\\bAIza[0-9A-Za-z_\\-]{35}" },
    { "id": "google-oauth-client-secret", "kind": "token", "group": 0, "regex": "\\bGOCSPX-[A-Za-z0-9_\\-]{20,}" },
    { "id": "aws-access-key-id", "kind": "token", "group": 0, "regex": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b" },
    { "id": "huggingface-token", "kind": "token", "group": 0, "regex": "\\bhf_[A-Za-z0-9]{30,}\\b" },
    { "id": "replicate-token", "kind": "token", "group": 0, "regex": "\\br8_[A-Za-z0-9]{30,}\\b" },
    { "id": "groq-key", "kind": "token", "group": 0, "regex": "\\bgsk_[A-Za-z0-9]{40,}\\b" },
    { "id": "tailscale-key", "kind": "token", "group": 0, "regex": "\\btskey-[A-Za-z0-9\\-]{20,}" },
    { "id": "supabase-token", "kind": "token", "group": 0, "regex": "\\b(?:sbp_[A-Za-z0-9]{30,}|sb_secret_[A-Za-z0-9_\\-]{20,})" },
    { "id": "gitlab-token", "kind": "token", "group": 0, "regex": "\\bglpat-[A-Za-z0-9_\\-]{20,}" },
    { "id": "sendgrid-key", "kind": "token", "group": 0, "regex": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b" },
    { "id": "jwt", "kind": "token", "group": 0, "regex": "\\beyJ[A-Za-z0-9_\\-]{8,}\\.eyJ[A-Za-z0-9_\\-]{8,}\\.[A-Za-z0-9_\\-]{8,}" },
    { "id": "url-credentials", "kind": "password", "group": 1, "regex": "\\b[a-zA-Z][a-zA-Z0-9+.\\-]{1,20}://[^\\s:/@\"'<>]{1,128}:([^\\s@/\"'<>]{3,256})@" },
    { "id": "bearer-token", "kind": "token", "group": 1, "regex": "(?i)\\bBearer\\s+([A-Za-z0-9\\-._~+/]{16,}=*)" },
    { "id": "basic-auth", "kind": "password", "group": 1, "regex": "(?i)\\bBasic\\s+([A-Za-z0-9+/]{16,}={0,2})" },
    { "id": "authorization-header", "kind": "token", "group": 1, "regex": "(?i)\\b(?:authorization|x-api-key|api-key|x-auth-token|private-token)[\"']?\\s*[:=]\\s*[\"']?(?:Bearer\\s+|Basic\\s+|token\\s+)?([A-Za-z0-9\\-._~+/=]{12,})" },
    { "id": "npmrc-auth", "kind": "token", "group": 1, "regex": "(?i)(?:_authToken|_auth|_password)\\s*=\\s*([^\\s\"']+)" },
    { "id": "azure-storage-key", "kind": "token", "group": 1, "regex": "(?i)AccountKey=([A-Za-z0-9+/=]{20,})" },
    { "id": "sas-signature", "kind": "token", "group": 1, "regex": "(?i)[?&]sig=([A-Za-z0-9%+/=]{20,})" },
    { "id": "cli-secret-flag", "kind": "password", "group": 1, "regex": "(?i)(?:^|\\s)--?(?:password|passwd|pass|pwd|token|secret|api-?key|apikey|auth-?token|access-?token|client-?secret)(?:\\s+|=|:)(\"[^\"]{3,}\"|'[^']{3,}'|[^\\s\"']{3,})" },
    { "id": "securestring-plaintext", "kind": "password", "group": 1, "regex": "(?i)ConvertTo-SecureString\\s+(?:-String\\s+)?(\"[^\"]+\"|'[^']+')" },
    { "id": "cmdkey-pass", "kind": "password", "group": 1, "regex": "(?i)/pass(?:word)?:(\\S+)" },
    { "id": "generic-assignment", "kind": "generic", "group": 1, "regex": "(?i)\\b[A-Z0-9_.\\-]*(?:SECRET|TOKEN|PASSWORD|PASSWD|PWD|API[_\\-]?KEY|ACCESS[_\\-]?KEY|PRIVATE[_\\-]?KEY|CLIENT[_\\-]?SECRET|AUTH[_\\-]?KEY|CREDENTIALS?|CONN(?:ECTION)?[_\\-]?STRING)[A-Z0-9_.\\-]*[\"']?\\s*[:=]\\s*[\"']?((?=[^\\s\"'`,;{}]*\\d)(?=[^\\s\"'`,;{}]*[A-Za-z])(?!\\d{4}-\\d{2}-\\d{2})(?![A-Za-z]:\\\\)(?!/)(?!https?://)(?![^\\s\"'`,;{}]*\\\\)[^\\s\"'`,;{}]{12,})" }
  ]
}
